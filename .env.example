# Environment Variables for Django Fleet Management System
# Copy this file to .env and update the values as needed

# Django Settings
SECRET_KEY=your-secret-key-here-make-it-long-and-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database Configuration
# For SQLite (default - no changes needed)
DATABASE_URL=sqlite:///db.sqlite3

# For PostgreSQL (uncomment and configure)
# DATABASE_URL=postgres://username:password@localhost:5432/fleet_management

# For MySQL (uncomment and configure)
# DATABASE_URL=mysql://username:password@localhost:3306/fleet_management

# Email Configuration (for notifications, password resets, etc.)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Static and Media Files
STATIC_URL=/static/
MEDIA_URL=/media/

# Security Settings (for production)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Fleet Management Specific Settings
DEFAULT_DAILY_TARGET=19288.50
DEFAULT_TONNAGE=33
DEFAULT_FUEL_RATE=25.00

# FleetCam Integration (optional)
FLEETCAM_API_URL=https://api.fleetcam.com
FLEETCAM_API_KEY=your-fleetcam-api-key

# Logging
LOG_LEVEL=INFO